#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

int main()
{
    int fd[2];
    pid_t pid1, pid2;

    if (pipe(fd) == -1)
    {
        perror("pipe failed");
        exit(1);
    }

    // Create first child
    pid1 = fork();

    if (pid1 < 0)
    {
        perror("fork failed");
        exit(1);
    }

    if (pid1 == 0)
    {
        // First child: ls -l

        close(fd[0]);

        dup2(fd[1], STDOUT_FILENO);

        close(fd[1]);

        execlp("ls", "ls", "-l", NULL);

        perror("execlp ls failed");
        exit(1);
    }

    // Create second child
    pid2 = fork();

    if (pid2 < 0)
    {
        perror("fork failed");
        exit(1);
    }

    if (pid2 == 0)
    {
        // Second child: grep ".c"

        close(fd[1]);

        dup2(fd[0], STDIN_FILENO);

        close(fd[0]);

        execlp("grep", "grep", ".c", NULL);

        perror("execlp grep failed");
        exit(1);
    }

    // Parent closes both ends
    close(fd[0]);
    close(fd[1]);

    // Wait for both children
    waitpid(pid1, NULL, 0);
    waitpid(pid2, NULL, 0);

    printf("\nCommand execution completed.\n");

    return 0;
}
